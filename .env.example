# Copie este arquivo para ".env" (uso local) e/ou configure as mesmas
# variáveis nas "Environment Variables" do projeto na Vercel.

# Connection string do Postgres (Neon). Ex:
# postgresql://usuario:senha@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Qualquer string longa e aleatória — usada para assinar o cookie de login.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Senha do usuário admin criado automaticamente no primeiro boot
# (login: admin@pedrinhooutlet.com). Troque no painel em "Minha conta" depois.
ADMIN_DEFAULT_PASSWORD=Pedrinho@2026

# Token do Vercel Blob (armazenamento das fotos dos produtos).
# É preenchida SOZINHA pela Vercel quando você conecta um Blob store ao
# projeto (Storage > Create Database > Blob). Não precisa colar manualmente
# em produção — só se quiser rodar upload real localmente.
BLOB_READ_WRITE_TOKEN=

PORT=3001
NODE_ENV=development
