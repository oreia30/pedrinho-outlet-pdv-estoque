<%- include('../partials/head', { title: 'Editar lançamento' }) %>
<%- include('../partials/sidebar', { active: 'caixa' }) %>

<h1>Editar lançamento</h1>
<p class="subtitle">Corrige um lançamento manual do caixa</p>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<div class="form-card">
  <form method="POST" action="/caixa/<%= tx.id %>/editar">
    <div class="form-grid">
      <div class="form-row">
        <label>Tipo</label>
        <select name="type">
          <option value="entrada" <%= tx.type === 'entrada' ? 'selected' : '' %>>Entrada</option>
          <option value="saida" <%= tx.type === 'saida' ? 'selected' : '' %>>Saída</option>
        </select>
      </div>
      <div class="form-row">
        <label>Valor (R$)</label>
        <input type="number" step="0.01" min="0" name="amount" value="<%= Number(tx.amount).toFixed(2) %>" required />
      </div>
    </div>
    <div class="form-row">
      <label>Categoria</label>
      <input type="text" name="category" value="<%= tx.category %>" required />
    </div>
    <div class="form-row">
      <label>Descrição (opcional)</label>
      <input type="text" name="description" value="<%= tx.description || '' %>" />
    </div>
    <button class="btn" type="submit">Salvar</button>
    <a class="btn secondary" href="/caixa">Cancelar</a>
  </form>
</div>

<%- include('../partials/footer') %>
