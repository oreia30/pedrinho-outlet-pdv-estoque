<%- include('../partials/head', { title: 'Caixa' }) %>
<%- include('../partials/sidebar', { active: 'caixa' }) %>

<h1>Caixa</h1>
<p class="subtitle">Entradas e saídas — vendas da loja e do balcão entram aqui sozinhas</p>

<% if (saldo !== null) { %>
  <div class="cards">
    <div class="card">
      <div class="label">Saldo atual</div>
      <div class="value">R$ <%= saldo.toFixed(2) %></div>
    </div>
  </div>
<% } %>

<% if (typeof erro !== 'undefined' && erro) { %><div class="error-box"><%= erro %></div><% } %>
<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<div class="form-card" style="margin-bottom:28px;">
  <form method="POST" action="/caixa">
    <div class="form-grid">
      <div class="form-row">
        <label>Tipo</label>
        <select name="type">
          <option value="entrada">Entrada</option>
          <option value="saida">Saída</option>
        </select>
      </div>
      <div class="form-row">
        <label>Valor (R$)</label>
        <input type="number" step="0.01" min="0" name="amount" required />
      </div>
    </div>
    <div class="form-row">
      <label>Categoria</label>
      <input type="text" name="category" placeholder="Ex: venda balcão, aluguel, fornecedor" required />
    </div>
    <div class="form-row">
      <label>Descrição (opcional)</label>
      <input type="text" name="description" />
    </div>
    <button class="btn" type="submit">Lançar</button>
  </form>
</div>

<table>
  <thead><tr><th>Tipo</th><th>Categoria</th><th>Valor</th><th>Descrição</th><th>Data</th><th></th></tr></thead>
  <tbody>
    <% transactions.forEach(function(t) { %>
      <tr>
        <td><span class="badge <%= t.type === 'entrada' ? 'pago' : 'cancelado' %>"><%= t.type %></span></td>
        <td><%= t.category %></td>
        <td>R$ <%= Number(t.amount).toFixed(2) %></td>
        <td><%= t.description || '-' %></td>
        <td><%= new Date(t.created_at).toLocaleString('pt-BR') %></td>
        <td>
          <% if (!t.ref_type) { %>
            <a class="btn small secondary" href="/caixa/<%= t.id %>/editar">Editar</a>
            <form method="POST" action="/caixa/<%= t.id %>/excluir" style="display:inline" onsubmit="return confirm('Excluir este lançamento?');">
              <button class="btn small danger" type="submit">Excluir</button>
            </form>
          <% } else { %>
            <span class="hint">🔗 venda — <a href="/pedidos">ver em Pedidos</a></span>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!transactions.length) { %>
      <tr><td colspan="6">Nenhum lançamento ainda.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>
