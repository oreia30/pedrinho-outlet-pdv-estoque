<%- include('../partials/head', { title: 'Pedidos' }) %>
<%- include('../partials/sidebar', { active: 'pedidos' }) %>

<div class="toolbar">
  <div>
    <h1>Pedidos</h1>
    <p class="subtitle">Vendas da loja online e do balcão — estoque e caixa são atualizados automaticamente</p>
  </div>
  <a class="btn" href="/pdv">+ Nova venda (balcão)</a>
</div>

<% if (typeof erro !== 'undefined' && erro) { %><div class="error-box"><%= erro %></div><% } %>

<table>
  <thead>
    <tr><th>Canal</th><th>Cliente</th><th>Itens</th><th>Desconto</th><th>Total</th><th>Pagamento</th><th>Status</th><th>Data</th><th></th></tr>
  </thead>
  <tbody>
    <% orders.forEach(function(o) { %>
      <tr>
        <td><span class="badge <%= o.channel === 'balcao' ? 'balcao' : 'loja' %>"><%= o.channel === 'balcao' ? 'Balcão' : 'Loja' %></span></td>
        <td><%= o.customer_name %><% if (o.customer_contact) { %><div class="hint"><%= o.customer_contact %></div><% } %></td>
        <td>
          <% (o.items || []).forEach(function(item) { %>
            <div><%= item.quantity %>x <%= item.name %></div>
          <% }) %>
        </td>
        <td><%= Number(o.discount) > 0 ? 'R$ ' + Number(o.discount).toFixed(2) : '-' %></td>
        <td>R$ <%= Number(o.total).toFixed(2) %></td>
        <td><%= o.payment_method || '-' %></td>
        <td>
          <form method="POST" action="/pedidos/<%= o.id %>/status" style="display:inline">
            <select name="status" onchange="this.form.submit()">
              <option value="pendente" <%= o.status === 'pendente' ? 'selected' : '' %>>pendente</option>
              <option value="pago" <%= o.status === 'pago' ? 'selected' : '' %>>pago</option>
              <option value="cancelado" <%= o.status === 'cancelado' ? 'selected' : '' %>>cancelado</option>
            </select>
          </form>
        </td>
        <td><%= new Date(o.created_at).toLocaleString('pt-BR') %></td>
        <td>
          <% if (o.channel === 'balcao' && o.status !== 'cancelado') { %>
            <a class="btn small secondary" href="/pedidos/<%= o.id %>/editar">Editar</a>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!orders.length) { %>
      <tr><td colspan="9">Nenhum pedido ainda.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('../partials/footer') %>
